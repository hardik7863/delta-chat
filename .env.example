# Copy to .env and fill in. NEVER commit .env.  ── all keys read from env, none baked in.

# ---- LLM provider (swappable) ----
# provider: anthropic | openai | ollama | echo   (echo = deterministic offline stub, no key)
DELTA_LLM_PROVIDER=anthropic
DELTA_LLM_MODEL=claude-opus-4-8
DELTA_LLM_MODEL_FAST=claude-haiku-4-5-20251001

# Credentials (only the one matching your provider is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- ingestion ----
DELTA_OCR_DPI=250
DELTA_OCR_ENGINE=paddle          # paddle | tesseract

# ---- delta thresholds (config over hardcoding) ----
DELTA_TAG_FUZZY_THRESHOLD=88
DELTA_TEXT_FUZZY_THRESHOLD=82
DELTA_SPATIAL_MOVE_THRESHOLD=12

# ---- retrieval ----
DELTA_RETRIEVAL_TOP_K=8
DELTA_RETRIEVAL_MIN_SCORE=0.12
DELTA_EMBEDDING_BACKEND=hash     # hash (deterministic, zero-dep) | anthropic | bge
